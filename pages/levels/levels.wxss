.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
}

.head {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 16rpx 32rpx 8rpx;
}

.level-tag {
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  background: var(--theme-color, #1677ff);
  color: #fff;
  font-size: 24rpx;
  font-weight: 600;
}

.head-meta {
  margin-left: 16rpx;
  font-size: 24rpx;
  color: #8a919f;
}

.card-swiper {
  flex: 1;
  min-height: 0;
  height: 100%;
}

.swiper-item {
  display: block;
  height: 100%;
}

.slide {
  box-sizing: border-box;
  height: calc(100% - 32rpx);
  margin: 16rpx 24rpx;
  padding: 28rpx;
  background: #fff;
  border-radius: 24rpx;
  display: flex;
  flex-direction: column;
  box-shadow: 0 6rpx 24rpx rgba(22, 119, 255, 0.06);
  overflow: hidden;
}

.level-head {
  flex-shrink: 0;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f2f3f5;
}

.lh-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.lh-pos {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--theme-color, #1677ff);
}

.lh-type {
  margin-left: 16rpx;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: #eef5ff;
  color: #0958d9;
  font-size: 22rpx;
}

.lh-passed {
  margin-left: auto;
  color: #389e0d;
  font-size: 22rpx;
}

.lh-sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #8a919f;
}

.state-box {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 0;
}

.lock-icon {
  font-size: 88rpx;
  margin-bottom: 24rpx;
}

.empty-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #4e5969;
  text-align: center;
}

.empty-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 32rpx;
}

/* 3D 层叠卡片堆（§7.1.3） */
.card-deck {
  position: relative;
  flex: 1;
  min-height: 0;
  margin-top: 24rpx;
  perspective: 900px;
  perspective-origin: 50% 42%;
  transform-style: preserve-3d;
}

.stacked-card {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  background: #fff;
  border: 1rpx solid #f0f1f3;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 8rpx 28rpx rgba(22, 119, 255, 0.08);
  transform-style: preserve-3d;
  will-change: transform, opacity;
  transition: transform .42s cubic-bezier(.22,.61,.36,1), opacity .42s ease;
  backface-visibility: hidden;
}

.stacked-card.depth-0 { transform: translate3d(0, 0, 0) scale(1); opacity: 1; }
.stacked-card.depth-1 { transform: translate3d(0, 26rpx, -90px) scale(.94); opacity: .70; pointer-events: none; }
.stacked-card.depth-2 { transform: translate3d(0, 52rpx, -180px) scale(.88); opacity: .42; pointer-events: none; }

.q-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-bottom: 20rpx;
}

.q-kind {
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  background: #f5f7fa;
  color: #86909c;
  font-size: 22rpx;
}

.q-count {
  margin-left: auto;
  font-size: 24rpx;
  color: #8a919f;
}

.question-image {
  width: 100%;
  display: block;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  background: #f7f8fa;
}

.q-title {
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.5;
  color: #1f2329;
  margin-bottom: 24rpx;
}

.option {
  padding: 22rpx 24rpx;
  margin-bottom: 16rpx;
  border-radius: 16rpx;
  background: #f7f8fa;
  border: 2rpx solid transparent;
  font-size: 28rpx;
  color: #1f2329;
}

.option-correct {
  background: #f6ffed;
  border-color: #52c41a;
  color: #389e0d;
}

.option-wrong {
  background: #fff1f0;
  border-color: #ff4d4f;
  color: #cf1322;
}

.explain {
  margin-top: 12rpx;
  padding: 18rpx 20rpx;
  border-radius: 12rpx;
  background: #f5f7fa;
  font-size: 24rpx;
  line-height: 1.5;
  color: #4e5969;
}

/* 答题反馈：你的答案 / 正确答案对比卡片 */
.answer-feedback {
  margin-top: 12rpx;
  padding: 18rpx 20rpx;
  border-radius: 12rpx;
  border-left: 6rpx solid transparent;
}

.answer-feedback.is-correct {
  background: #f6ffed;
  border-left-color: #52c41a;
}

.answer-feedback.is-wrong {
  background: #fff1f0;
  border-left-color: #ff4d4f;
}

.af-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-bottom: 10rpx;
}

.af-icon {
  margin-right: 8rpx;
  font-size: 28rpx;
  font-weight: 700;
}

.af-title {
  font-size: 26rpx;
  font-weight: 600;
}

.is-correct .af-icon,
.is-correct .af-title {
  color: #389e0d;
}

.is-wrong .af-icon,
.is-wrong .af-title {
  color: #cf1322;
}

.af-row {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  margin-top: 6rpx;
}

.af-label {
  width: 140rpx;
  flex-shrink: 0;
  font-size: 24rpx;
  color: #8a919f;
}

.af-value {
  flex: 1;
  font-size: 24rpx;
  line-height: 1.5;
}

.af-value.good {
  color: #389e0d;
  font-weight: 600;
}

.af-value.bad {
  color: #cf1322;
  text-decoration: line-through;
}

.confirm-bar {
  margin-top: 16rpx;
  flex-shrink: 0;
}

.confirm-btn {
  width: 100%;
  min-height: 80rpx;
  line-height: 80rpx;
  margin: 0;
  font-size: 28rpx;
}

.audio-bar {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 14rpx 20rpx;
  margin-bottom: 20rpx;
  border-radius: 12rpx;
  background: #eef5ff;
}

.audio-btn {
  width: 64rpx;
  height: 64rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--theme-color, #1677ff);
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(22, 119, 255, 0.25);
}

.audio-btn.is-playing {
  background: #0958d9;
}

.audio-stop {
  margin-left: 12rpx;
  background: #4e5969;
  box-shadow: none;
}

.audio-icon {
  font-size: 26rpx;
  line-height: 1;
}

.audio-track {
  position: relative;
  flex: 1;
  height: 8rpx;
  margin-left: 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.9);
  overflow: visible;
}

.audio-fill {
  height: 100%;
  border-radius: 999rpx;
  background: var(--theme-color, #1677ff);
}

.audio-dot {
  position: absolute;
  top: 50%;
  width: 20rpx;
  height: 20rpx;
  margin-left: -10rpx;
  border-radius: 50%;
  background: var(--theme-color, #1677ff);
  transform: translateY(-50%);
  box-shadow: 0 2rpx 6rpx rgba(22, 119, 255, 0.3);
}

.audio-progress {
  margin-left: 16rpx;
  min-width: 110rpx;
  text-align: right;
  font-size: 22rpx;
  color: #4e5969;
  font-variant-numeric: tabular-nums;
}

.audio-error {
  color: #cf1322;
  font-size: 22rpx;
  margin-bottom: 12rpx;
}

/* 后排骨架占位线 */
.ghost-line {
  height: 28rpx;
  border-radius: 8rpx;
  background: #f0f1f3;
  margin-bottom: 20rpx;
}

.ghost-line.short {
  width: 60%;
}

/* 结算面板 */
.result-box {
  justify-content: flex-start;
  padding-top: 40rpx;
}

.result-stars {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  line-height: 1;
}

.star-icon {
  font-size: 76rpx;
  line-height: 1;
  color: #d9d9d9;
}

.star-icon.filled {
  color: #ff9500;
  text-shadow: 0 4rpx 16rpx rgba(255, 149, 0, 0.45);
}

.result-score {
  margin-top: 16rpx;
  font-size: 34rpx;
  font-weight: 600;
  color: #1f2329;
}

.review-entry {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: var(--theme-color, #1677ff);
}

.review-arrow {
  margin-left: 4rpx;
  font-size: 32rpx;
  line-height: 1;
}

.submit-error {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #cf1322;
}

.link {
  margin-left: 12rpx;
  color: var(--theme-color, #1677ff);
  text-decoration: underline;
}

.result-actions {
  width: 100%;
  box-sizing: border-box;
  margin-top: auto;
  display: flex;
  flex-direction: row;
  gap: 16rpx;
  flex-shrink: 0;
}

.btn-ghost {
  background: #f5f7fa;
  color: #4e5969;
  border-radius: 16rpx;
  font-size: 32rpx;
}

.result-actions .btn-primary,
.result-actions .btn-ghost {
  flex: 1 1 0;
  width: 0;
  min-width: 0;
  box-sizing: border-box;
  padding: 0 8rpx;
  min-height: 88rpx;
  line-height: 88rpx;
  margin: 0;
  white-space: nowrap;
}

.all-done {
  flex: 1;
  text-align: center;
  color: #389e0d;
  font-size: 26rpx;
  line-height: 88rpx;
}

.error {
  color: #d4380d;
  margin-bottom: 16rpx;
  text-align: center;
}

.btn-primary {
  margin-top: 24rpx;
  flex-shrink: 0;
  min-height: 88rpx;
  line-height: 88rpx;
}

/* 已完成关卡回顾（只读） */
.review-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 1000;
  background: rgba(15, 23, 42, 0.45);
  display: flex;
  align-items: flex-end;
}

.review-panel {
  width: 100%;
  height: 88%;
  background: #fff;
  border-radius: 28rpx 28rpx 0 0;
  box-sizing: border-box;
  padding: 28rpx 28rpx calc(24rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
}

.review-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.review-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1f2329;
}

.review-close {
  padding: 8rpx 12rpx;
  font-size: 28rpx;
  color: #1677ff;
}

.review-sub {
  margin: 8rpx 0 16rpx;
  font-size: 24rpx;
  color: #86909c;
}

.review-body {
  flex: 1;
  min-height: 0;
}

.review-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f2f5;
}

.review-item:last-child {
  border-bottom: none;
}

.ri-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.ri-no {
  font-size: 26rpx;
  font-weight: 600;
  color: #1f2329;
}

.ri-kind {
  font-size: 22rpx;
  color: #86909c;
}

.ri-status {
  margin-left: auto;
  font-size: 22rpx;
}

.ri-status.is-good {
  color: #389e0d;
}

.ri-status.is-bad {
  color: #cf1322;
}

.ri-status.is-muted {
  color: #86909c;
}

.review-option {
  position: relative;
  padding: 16rpx 20rpx;
  margin-bottom: 12rpx;
  border-radius: 12rpx;
  background: #f7f8fa;
  font-size: 28rpx;
  color: #1f2329;
}

.review-option.is-correct {
  background: #f6ffed;
  border: 1rpx solid #b7eb8f;
}

.review-option.is-wrong {
  background: #fff1f0;
  border: 1rpx solid #ffa39e;
}

.review-tag {
  margin-left: 12rpx;
  font-size: 22rpx;
  color: #1677ff;
}

.review-answer {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #4e5969;
}

.review-answer .is-good {
  color: #389e0d;
}

.review-explain {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #86909c;
  line-height: 1.6;
}

.review-back {
  margin-top: 16rpx;
  flex-shrink: 0;
  min-height: 88rpx;
  line-height: 88rpx;
}
