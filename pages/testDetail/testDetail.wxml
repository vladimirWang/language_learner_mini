<view class="page">
  <view class="card" wx:if="{{loading}}">
    <view class="muted">加载中…</view>
  </view>

  <view class="card" wx:elif="{{error}}">
    <view class="error">{{error}}</view>
    <button class="btn-primary" bindtap="retry">重试</button>
  </view>

  <block wx:else>
    <view class="card summary" wx:if="{{level}}">
      <view class="row">
        <view class="level-name">{{level.name}}</view>
        <view class="tag">{{level.difficulty}}</view>
      </view>
      <view class="muted summary-meta">{{level.lang}} · {{exams.length}} 个任务</view>
      <view class="description" wx:if="{{level.description}}">{{level.description}}</view>
    </view>

    <view class="section-title">关联任务</view>

    <view class="card empty" wx:if="{{exams.length === 0}}">
      <view class="empty-title">暂无关联任务</view>
      <view class="muted">该测试还没有配置听力或口语内容</view>
    </view>

    <view class="card exam-item" wx:for="{{exams}}" wx:key="key">
      <view class="row">
        <view class="exam-name">{{item.name}}</view>
        <view class="tag">{{item.typeLabel}}</view>
      </view>
      <view class="muted exam-meta" wx:if="{{item.lang}}">{{item.lang}}</view>
    </view>
  </block>
</view>
