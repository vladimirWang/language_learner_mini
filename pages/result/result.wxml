<view class="page">
  <view class="card empty-state" wx:if="{{ready && !hasData}}">
    <view class="empty-title">还没有答题结果</view>
    <view class="muted">先去完成今天的关卡吧</view>
  </view>

  <view class="card summary" wx:elif="{{ready}}">
    <view class="score {{checkedIn ? 'pass' : 'fail'}}">{{score}} / {{total}}</view>
    <view class="star-score">本次 {{stars}} 星</view>
    <view class="muted">历史最高 {{bestStars}} 星 · 累计 {{totalStars}} 星</view>
    <view class="badge {{checkedIn ? 'badge-pass' : 'badge-fail'}}">
      {{checkedIn ? '已自动打卡' : '至少获得 2 星后自动打卡'}}
    </view>
    <view class="star-added" wx:if="{{starsAdded > 0}}">本次新增 {{starsAdded}} 星</view>
    <view class="muted no-improvement" wx:if="{{starsAdded === 0}}">本次未增加累计星</view>
    <view class="muted retry-tip" wx:if="{{stars < 2 && !checkedIn}}">本次不足 2 星且尚未签到，可继续重考</view>
    <view class="muted" wx:if="{{streak}}">连续打卡 {{streak.current}} 天 · 最长 {{streak.longest}} 天</view>
    <view class="muted challenge-meta">{{day}} · {{title}}</view>
  </view>

  <view class="card" wx:for="{{items}}" wx:key="seq">
    <view class="row">
      <view class="q-index">第 {{item.seq}} 题</view>
      <view class="{{item.correct ? 'pass' : 'fail'}}">{{item.correct ? '正确' : '错误'}}</view>
    </view>
    <view class="correct-answer">正确答案：{{item.correct_answer}}</view>
    <view class="muted explanation">{{item.explanation}}</view>
  </view>

  <view class="footer">
    <button class="btn-primary" bindtap="goHome">返回首页</button>
  </view>
</view>
