<view class="page">
  <view class="card empty-state" wx:if="{{ready && !hasData}}">
    <view class="empty-title">还没有答题结果</view>
    <view class="muted">先去完成今天的关卡吧</view>
  </view>

  <view class="card summary" wx:elif="{{ready}}">
    <view class="score {{passed ? 'pass' : 'fail'}}">{{score}} / {{total}}</view>
    <view class="badge {{passed ? 'badge-pass' : 'badge-fail'}}">
      {{passed ? '打卡成功' : '未达到 80%，明天再来'}}
    </view>
    <view class="muted" wx:if="{{streak}}">连续打卡 {{streak.current}} 天 · 最长 {{streak.longest}} 天</view>
    <view class="muted">{{day}} · {{title}}</view>
  </view>

  <view class="card" wx:for="{{items}}" wx:key="seq">
    <view class="row">
      <view class="q-index">第 {{item.seq}} 题</view>
      <view class="{{item.correct ? 'pass' : 'fail'}}">{{item.correct ? '正确' : '错误'}}</view>
    </view>
    <view class="correct-answer">正确答案：{{item.correct_answer}}</view>
    <view class="muted explanation">{{item.explanation}}</view>
  </view>

  <view class="footer">
    <button class="btn-primary" bindtap="goHome">返回首页</button>
  </view>
</view>
