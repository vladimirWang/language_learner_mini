.page {
  padding-bottom: 40rpx;
}

.summary {
  text-align: center;
}

.empty-state {
  text-align: center;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.score {
  font-size: 72rpx;
  font-weight: 700;
  line-height: 1.2;
}

.star-score {
  margin-top: 16rpx;
  color: #ad6800;
  font-size: 42rpx;
  font-weight: 700;
}

.star-added {
  margin-bottom: 12rpx;
  color: #ad6800;
  font-size: 28rpx;
}

.no-improvement {
  margin-bottom: 12rpx;
}

.retry-tip {
  margin-bottom: 12rpx;
  color: #ad6800;
}

.challenge-meta {
  margin-top: 12rpx;
}

.badge {
  display: inline-block;
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  margin: 16rpx 0 20rpx;
}

.badge-pass {
  background: #f6ffed;
  color: #389e0d;
}

.badge-fail {
  background: #fff1f0;
  color: #cf1322;
}

.pass {
  color: #389e0d;
}

.fail {
  color: #cf1322;
}

.q-index {
  font-weight: 600;
  color: #1677ff;
}

.correct-answer {
  margin-top: 12rpx;
  font-size: 30rpx;
}

.explanation {
  margin-top: 8rpx;
  font-size: 26rpx;
  line-height: 1.5;
}

.footer {
  padding: 0 24rpx;
}
