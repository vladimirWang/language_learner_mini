<view class="page">
  <view class="card" wx:if="{{loading}}">
    <view class="muted">加载中…</view>
  </view>

  <view class="card" wx:elif="{{error}}">
    <view class="error">{{error}}</view>
    <button class="btn-primary" bindtap="retry">重试</button>
  </view>

  <block wx:elif="{{challenge}}">
    <view class="card head">
      <view class="title">{{challenge.title}}</view>
      <view class="muted">标准 6 题每答对 2 题得 1 星 · 至少 2 星自动打卡</view>
      <view class="muted rule-tip">不足 6 题按正确率折算，并执行 60% 向下取整兜底</view>
      <view class="done-tip" wx:if="{{attempt}}">已恢复最近一次答案（本次 {{attempt.stars}} 星，历史最高 {{attempt.best_stars}} 星），可修改后重新提交。</view>
    </view>

    <view class="card" wx:for="{{items}}" wx:key="seq">
      <view class="q-head">
        <view class="q-index">第 {{item.seq}} 题</view>
        <view class="q-kind">{{item.kind === 'word' ? '单词' : item.kind === 'collocation' ? '固定搭配' : '语法'}}</view>
      </view>
      <view class="q-title">{{item.prompt.question}}</view>
      <view
        wx:for="{{item.prompt.options}}"
        wx:for-item="option"
        wx:for-index="optIndex"
        wx:key="*this"
        data-seq="{{item.seq}}"
        data-index="{{optIndex}}"
        bindtap="onSelect"
        class="option {{item.selectedIndex === optIndex ? 'option-active' : ''}}"
      >
        {{option}}
      </view>
    </view>

    <view class="footer">
      <button class="btn-primary" loading="{{submitting}}" bindtap="submit">{{attempt ? '重新提交' : '提交答案'}}</button>
    </view>
  </block>
</view>
