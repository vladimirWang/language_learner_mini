.profile {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.avatar-button {
  width: 110rpx;
  height: 110rpx;
  padding: 0;
  margin: 0 24rpx 0 0;
  border-radius: 50%;
  background: transparent;
  line-height: normal;
}

.avatar-button::after {
  border: 0;
}

.avatar {
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  background: #eef5ff;
}

.avatar-default {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #1677ff;
  font-size: 42rpx;
}

.profile-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.name {
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 6rpx;
}

.name-input {
  height: 52rpx;
  line-height: 52rpx;
}

.total-stars {
  margin-left: 20rpx;
  text-align: center;
}

.star-number {
  color: #ad6800;
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1.2;
}

.btn-save {
  margin-top: 24rpx;
  background: #1677ff;
  color: #fff;
  border-radius: 16rpx;
  font-size: 28rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.info-row {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #f2f3f5;
}

.info-value {
  font-size: 28rpx;
  color: #1f2329;
}

.tip {
  margin-top: 18rpx;
  font-size: 24rpx;
}

.streak-row {
  display: flex;
  flex-direction: row;
}

.streak-block {
  flex: 1;
  text-align: center;
}

.streak-num {
  font-size: 60rpx;
  font-weight: 700;
  color: #1677ff;
  line-height: 1.2;
}

.last-day {
  margin-top: 20rpx;
  font-size: 24rpx;
  text-align: center;
}

.footer {
  padding: 0 24rpx 40rpx;
}

.btn-reset {
  background: #fff1f0;
  color: #cf1322;
  border-radius: 16rpx;
  font-size: 30rpx;
}
