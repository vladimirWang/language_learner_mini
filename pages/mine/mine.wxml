<view class="page">
  <view class="card">
    <view class="profile">
      <button class="avatar-button" open-type="chooseAvatar" bind:chooseavatar="onChooseAvatar" disabled="{{!loggedIn}}" aria-label="选择微信头像">
        <image wx:if="{{avatarPreview}}" class="avatar" src="{{avatarPreview}}" mode="aspectFill" />
        <view wx:else class="avatar avatar-default">微</view>
      </button>
      <view class="profile-main">
        <input wx:if="{{loggedIn}}" class="name name-input" type="nickname" value="{{draftNickname}}" placeholder="微信用户" maxlength="64" bindinput="onNicknameInput" />
        <view wx:else class="name">未登录</view>
        <view class="muted">{{loggedIn ? nickname : '进入关卡将自动登录'}}</view>
      </view>
      <view class="total-stars">
        <view class="star-number">{{totalStars}}</view>
        <view class="muted">累计星星</view>
      </view>
    </view>
    <button wx:if="{{loggedIn}}" class="btn-save" loading="{{saving}}" disabled="{{saving}}" bindtap="onSaveProfile">保存头像与昵称</button>
    <view class="muted tip" wx:if="{{loadError}}">{{loadError}}</view>
  </view>

  <view class="card">
    <view class="section-title">学习偏好</view>
    <view class="info-row">
      <text class="muted">等级</text>
      <picker mode="selector" range="{{levels}}" value="{{levelIndex}}" bindchange="onLevelChange" disabled="{{!loggedIn}}">
        <view class="level-picker">{{level}} ▾</view>
      </picker>
    </view>
    <view class="muted tip">修改等级会保存到服务器，关卡与日历将按新等级刷新</view>
  </view>

  <view class="card calendar-entry" bindtap="goCalendar">
    <view class="row">
      <view>
        <view class="section-title">打卡日历</view>
        <view class="muted">连续 {{streak.current}} 天 · 最长 {{streak.longest}} 天</view>
        <view class="muted last-day" wx:if="{{streak.last_day}}">最近打卡：{{streak.last_day}}</view>
      </view>
      <view class="entry-arrow">›</view>
    </view>
  </view>
</view>
