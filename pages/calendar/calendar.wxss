.section-title {
  font-size: 30rpx;
  font-weight: 600;
}

.streak-row {
  display: flex;
  margin-top: 20rpx;
}

.streak-block {
  flex: 1;
}

.streak-num {
  font-size: 48rpx;
  font-weight: 700;
  color: #1677ff;
  line-height: 1.1;
}

.last-day {
  margin-top: 12rpx;
  font-size: 24rpx;
}

.month-nav {
  display: flex;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.btn-nav {
  font-size: 26rpx;
  padding: 8rpx 24rpx;
}

.calendar {
  display: flex;
  flex-wrap: wrap;
}

.weekday {
  width: 14.28%;
  text-align: center;
  color: #8a919f;
  font-size: 22rpx;
  padding: 8rpx 0;
}

.cell {
  width: 14.28%;
  display: flex;
  justify-content: center;
  padding: 8rpx 0;
}

.cell-inner {
  width: 52rpx;
  height: 52rpx;
  line-height: 52rpx;
  border-radius: 50%;
  text-align: center;
  font-size: 24rpx;
}

.cell-blank .cell-inner {
  color: transparent;
}

.cell-passed .cell-inner {
  background: #52c41a;
  color: #fff;
}

.cell-selected .cell-inner {
  border: 2rpx solid #1677ff;
}

.empty {
  padding: 48rpx 0;
}

.empty-title {
  font-size: 30rpx;
  color: #8a919f;
  text-align: center;
}

.error {
  color: #d4380d;
  margin-bottom: 16rpx;
}
