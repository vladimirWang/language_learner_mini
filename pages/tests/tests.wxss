.page {
  padding-bottom: 40rpx;
}

.title {
  font-size: 40rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.test-item .name {
  font-size: 32rpx;
  font-weight: 600;
}

.badge {
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
}

.badge-active {
  background: #f6ffed;
  color: #389e0d;
}

.badge-inactive {
  background: #f5f5f5;
  color: #8a919f;
}

.meta {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
}

.tag {
  margin-right: 16rpx;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  background: #eef5ff;
  color: #0958d9;
  font-size: 24rpx;
}

.description {
  margin-top: 16rpx;
  font-size: 26rpx;
  line-height: 1.5;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  padding: 24rpx 0;
  text-align: center;
}

.error {
  color: #d4380d;
  margin-bottom: 16rpx;
}
